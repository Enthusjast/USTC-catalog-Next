{
  "name": "ustc-catalog-next",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "typecheck": "vue-tsc --noEmit",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "format": "prettier --write src scripts index.html vite.config.ts tsconfig.json package.json README.md docs .github",
    "archives:sync": "node scripts/sync-archives.mjs",
    "dev:fixtures": "vite --mode fixtures --host 127.0.0.1",
    "check:api": "node scripts/check-api.mjs",
    "test": "vitest run",
    "test:browser": "tsc --noEmit -p tsconfig.browser.json && playwright test",
    "check:pwa": "node scripts/check-pwa.mjs",
    "rooms:check": "node scripts/sync-rooms.mjs --check",
    "rooms:sync": "node scripts/sync-rooms.mjs --write",
    "icourse:sync": "node scripts/sync-icourse.mjs",
    "icourse:check": "node scripts/sync-icourse.mjs --check"
  },
  "dependencies": {
    "@lucide/vue": "^1.54.0",
    "vue": "^3.5.43",
    "vue-router": "^5.4.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.6.4",
    "@vitejs/plugin-vue": "^6.0.9",
    "linkedom": "^0.18.13",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9.3",
    "vite": "^8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.3",
    "vue-tsc": "^3.3.12"
  }
}
